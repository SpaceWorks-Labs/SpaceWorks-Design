---
// The animated box from motion/box-open/, inlined so it can follow the page theme. `variant`: "loop" (the loader
// cycle), "once" (one shot, replayed by JS), "mono" (loop in the text colour) or "still" (nothing plays).
import markup from '../assets/kit/box-open-markup.html?raw';
// `ground`: the mark sits on a surface that is always light or dark (a themed demo card), not on the page theme:
// it adds the kit's forced-ground class (g-light / g-dark). Mono marks take the text colour and never need it.
interface Props { height?: number; variant?: 'loop' | 'once' | 'mono' | 'still'; class?: string; ground?: 'light' | 'dark' }
const { height = 72, variant = 'loop', class: extra = '', ground } = Astro.props;
const groundClass = ground && variant !== 'mono' ? `g-${ground}` : '';
const width = Math.round((height * 136) / 126);
const cls = variant === 'loop' ? 'loop' : variant === 'mono' ? 'loop mono' : variant === 'once' ? 'sw-box-hover' : '';
---

<span class:list={['sw-box', cls, groundClass, extra]} aria-hidden="true" style={`display:inline-block;width:${width}px;height:${height}px`} set:html={markup} />
