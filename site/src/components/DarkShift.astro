---
// Before/after dark tokens as real swatches: the two superseded dark palettes (src/data/dark-before.json, copied
// once from git history) against the current dark palette read from tokens/tokens.json.
import tokens from '../assets/kit/tokens.json';
import before from '../data/dark-before.json';
const now = tokens.dark as Record<string, string>;
const deep = before.deepInk as Record<string, string>;
const green = before.greenTinted as Record<string, string>;
const names = Object.keys(deep);
const cols = [
  { label: 'Deep Ink dark (0.10)', v: deep },
  { label: 'Black with green layers (0.11)', v: green },
  { label: 'Solid black (0.12.0)', v: now },
];
---

<div class="not-content sw-shift">
  <table class="sw-tokens">
    <thead>
      <tr>
        <th scope="col">Token</th>
        {cols.map((c) => <th scope="col">{c.label}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        names.map((n) => (
          <tr>
            <td><code>--color-{n}</code></td>
            {cols.map((c) => (
              <td>
                <span class="sw-chip" style={`background:${c.v[n]}`} aria-hidden="true" />
                <code>{c.v[n]}</code>
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
  <div class="sw-shift__strips" aria-hidden="true">
    {
      cols.map((c) => (
        <div class="sw-shift__strip" style={`background:${c.v.bg};border-color:${c.v.line}`}>
          <span style={`background:${c.v.surface}`}></span>
          <span style={`background:${c.v.panel}`}></span>
          <span style={`background:${c.v.hover}`}></span>
          <b style={`color:${c.v.ink}`}>{c.label}</b>
        </div>
      ))
    }
  </div>
</div>

<style>
  .sw-shift { min-width: 0; }
  .sw-shift__strips { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: 0.75rem; margin-block: 1rem; }
  .sw-shift__strip { display: flex; flex-wrap: wrap; min-width: 0; align-items: center; gap: 0.4rem; padding: 0.9rem; border: 1px solid; border-radius: 12px; }
  .sw-shift__strip span { flex: none; width: 2rem; height: 2rem; border-radius: 8px; }
  .sw-shift__strip b { flex: 1 1 9rem; min-width: 0; margin-inline-start: auto; font-size: 0.8125rem; font-weight: 600; text-align: end; }
</style>
