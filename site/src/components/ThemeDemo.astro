---
// Live theming demo: a Light / Dark / System switch that re-themes a small sample UI with the real tokens.
// The sample is scoped (.sw-scope from tokens-scope.css), so the surrounding page keeps the reader's theme.
import BoxMark from './BoxMark.astro';
import Wordmark from './Wordmark.astro';
---

<sw-theme-demo class="not-content">
  <div role="radiogroup" aria-label="Demo theme" class="sw-seg">
    <button type="button" role="radio" aria-checked="false" data-mode="light">Light</button>
    <button type="button" role="radio" aria-checked="false" data-mode="dark">Dark</button>
    <button type="button" role="radio" aria-checked="true" data-mode="system">System</button>
  </div>
  <p class="sw-demo-cap" data-note>Following your system: light.</p>
  <div class="sw-scope sw-sample" data-scope>
    <div class="sw-sample__logo" data-hover-logo>
      <BoxMark height={34} variant="once" />
      <Wordmark height="1.75rem" />
    </div>
    <div class="sw-sample__grid">
      <div class="sw-sample__card">
        <p class="sw-sample__title">Issue the laser cutter</p>
        <p>Scan the box, add the issue photo, hand it over.</p>
        <label class="sw-sample__label" for="sw-demo-input">Remark</label>
        <input id="sw-demo-input" class="sw-sample__input" placeholder="Anything the next person should know" />
        <div class="sw-sample__row">
          <button type="button" class="sw-sample__btn">Issue</button>
          <button type="button" class="sw-sample__btn sw-sample__btn--ghost">Cancel</button>
          <button type="button" class="sw-sample__btn sw-sample__btn--emph">Report issue</button>
        </div>
      </div>
      <div class="sw-sample__card">
        <p class="sw-sample__title">Status</p>
        <div class="sw-sample__row">
          <span class="sw-pill sw-pill--success"><i></i>Returned</span>
          <span class="sw-pill sw-pill--info"><i></i>Issued</span>
          <span class="sw-pill sw-pill--warn"><i></i>Due soon</span>
          <span class="sw-pill sw-pill--danger"><i></i>Lost</span>
        </div>
        <p class="sw-sample__title">Chart series</p>
        <div class="sw-bars" role="img" aria-label="Five bars in the five chart colours">
          <span style="--v:90;background:rgb(var(--chart-1));box-shadow:inset 0 0 0 1px rgb(var(--chart-edge))"></span>
          <span style="--v:70;background:rgb(var(--chart-2));box-shadow:inset 0 0 0 1px rgb(var(--chart-edge))"></span>
          <span style="--v:55;background:rgb(var(--chart-3));box-shadow:inset 0 0 0 1px rgb(var(--chart-edge))"></span>
          <span style="--v:40;background:rgb(var(--chart-4));box-shadow:inset 0 0 0 1px rgb(var(--chart-edge))"></span>
          <span style="--v:25;background:rgb(var(--chart-5));box-shadow:inset 0 0 0 1px rgb(var(--chart-edge))"></span>
        </div>
        <p class="sw-sample__title">Loading</p>
        <div class="sw-sample__row">
          <div role="status" aria-label="Loading"><BoxMark height={40} variant="loop" /></div>
          <button type="button" class="sw-sample__btn" aria-busy="true"><BoxMark height={18} variant="mono" /> Saving</button>
        </div>
      </div>
    </div>
  </div>
</sw-theme-demo>

<script>
  import { bindLogoHover } from './logoHover';

  class SwThemeDemo extends HTMLElement {
    connectedCallback() {
      const scope = this.querySelector<HTMLElement>('[data-scope]')!;
      const note = this.querySelector<HTMLElement>('[data-note]')!;
      const buttons = [...this.querySelectorAll<HTMLButtonElement>('[data-mode]')];
      const dark = matchMedia('(prefers-color-scheme: dark)');
      let mode = 'system';
      const apply = () => {
        const isDark = mode === 'dark' || (mode === 'system' && dark.matches);
        scope.classList.toggle('dark', isDark);
        note.textContent = mode === 'system' ? `Following your system: ${isDark ? 'dark' : 'light'}.` : `Forced ${mode}.`;
        buttons.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.mode === mode)));
      };
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          const next = b.dataset.mode!;
          const set = () => {
            mode = next;
            apply();
          };
          // The template's circle reveal from the pressed button (instant under reduced motion).
          const reveal = (window as any).SwThemeReveal;
          if (reveal) reveal.switchTheme(next, b, { apply: set });
          else set();
        }),
      );
      dark.addEventListener('change', apply);
      apply();
      // Same hover behaviour as the header logo.
      const logo = scope.querySelector<HTMLElement>('[data-hover-logo]');
      const mark = logo?.querySelector<HTMLElement>('.sw-box');
      if (logo && mark) bindLogoHover(logo, mark);
    }
  }
  customElements.define('sw-theme-demo', SwThemeDemo);
</script>
