---
// Every semantic colour token, light and dark side by side, read from tokens/tokens.json.
import tokens from '../assets/kit/tokens.json';

const light = tokens.light as Record<string, string>;
const dark = tokens.dark as Record<string, string>;

// Group by family: "accent-hover" belongs with "accent", "on-accent" too.
const family = (name: string) => {
  const base = name.replace(/^on-/, '').split('-')[0];
  return ['bg', 'surface', 'panel', 'hover', 'line', 'outline', 'ink', 'muted', 'focus'].includes(base)
    ? 'Surfaces and text'
    : base[0].toUpperCase() + base.slice(1);
};

const chart = tokens.chart as Record<string, any>;
const loader = tokens.loader as Record<string, any>;

const groups = new Map<string, string[]>();
for (const name of Object.keys(light)) {
  const key = family(name);
  groups.set(key, [...(groups.get(key) ?? []), name]);
}
---

{
  [...groups].map(([group, names]) => (
    <>
      <h3>{group}</h3>
      <table class="sw-tokens">
        <thead>
          <tr>
            <th scope="col">Token</th>
            <th scope="col">Light</th>
            <th scope="col">Dark</th>
          </tr>
        </thead>
        <tbody>
          {names.map((name) => (
            <tr>
              <td>
                <code>--color-{name}</code>
              </td>
              <td>
                <span class="sw-chip" style={`background:${light[name]}`} aria-hidden="true" />
                <code>{light[name]}</code>
              </td>
              <td>
                <span class="sw-chip" style={`background:${dark[name]}`} aria-hidden="true" />
                <code>{dark[name]}</code>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  ))
}

<h3>Chart series</h3>
<p>{chart.note}</p>
<table class="sw-tokens">
  <thead>
    <tr>
      <th scope="col">Token</th>
      <th scope="col">Light</th>
      <th scope="col">Dark</th>
    </tr>
  </thead>
  <tbody>
    {
      chart.order.map((name: string) => (
        <tr>
          <td>
            <code>--chart-{name}</code>
          </td>
          <td>
            <span class="sw-chip" style={`background:${chart.light[name]}`} aria-hidden="true" />
            <code>{chart.light[name]}</code>
          </td>
          <td>
            <span class="sw-chip" style={`background:${chart.dark[name]}`} aria-hidden="true" />
            <code>{chart.dark[name]}</code>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<h3>Box-open loader</h3>
<p>{loader.note}</p>
<table class="sw-tokens">
  <thead>
    <tr>
      <th scope="col">Token</th>
      <th scope="col">Light</th>
      <th scope="col">Dark</th>
    </tr>
  </thead>
  <tbody>
    {
      Object.keys(loader.light).map((name) => (
        <tr>
          <td>
            <code>--sw-{name === 'under' ? 'under' : name}</code>
          </td>
          <td>
            <span class="sw-chip" style={`background:${loader.light[name]}`} aria-hidden="true" />
            <code>{loader.light[name]}</code>
          </td>
          <td>
            <span class="sw-chip" style={`background:${loader.dark[name]}`} aria-hidden="true" />
            <code>{loader.dark[name]}</code>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
